# Plantilla de entorno para HostGrid Control Plane (deploy/.env).
# Copiar a deploy/.env y generar secretos criptográficos antes de iniciar.
# NUNCA hacer commit de deploy/.env al repositorio.

# --- Base de datos PostgreSQL 17 ---
POSTGRES_DB=hostgrid
POSTGRES_USER=hostgrid
# Generar con: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Control Plane (FastAPI) ---
HOSTGRID_ENV=production
# Generar con: openssl rand -hex 32 (mínimo 32 bytes)
HOSTGRID_JWT_SECRET=
HOSTGRID_API_PORT=8000
HOSTGRID_SERVER_PORT=8000
HOSTGRID_CORS_ORIGINS=http://127.0.0.1:8080
HOSTGRID_MAX_BUNDLE_SIZE_MB=25

# TLS / mTLS nativo opcional en Control Plane (dejar vacío para HTTP 8000 detrás de Nginx/proxy TLS).
# Al habilitar TLS directo en `server` (ej. para conectar `relay` a https://server:8443):
#   1. Descomentar el montaje `./certs/server:/etc/hostgrid/certs:ro` en deploy/docker-compose.yml.
#   2. Establecer HOSTGRID_SERVER_PORT=8443 y HOSTGRID_API_PORT=8443.
#   3. Definir HOSTGRID_TLS_CERTFILE y HOSTGRID_TLS_KEYFILE (y opcionalmente HOSTGRID_TLS_CA_CERTS para mTLS).
HOSTGRID_TLS_CERTFILE=
HOSTGRID_TLS_KEYFILE=
HOSTGRID_TLS_CA_CERTS=
HOSTGRID_HEALTH_URL=
HOSTGRID_HEALTH_CA=
HOSTGRID_HEALTH_CLIENT_CERT=
HOSTGRID_HEALTH_CLIENT_KEY=

# Clave pública Ed25519 en Base64 (32 bytes) para verificar bundles air-gapped y artefactos firmados.
# Generar par de claves en entorno seguro; publicar solo la clave pública aquí.
HOSTGRID_BUNDLE_SIGNING_PUBKEY_B64=

# Opcional: clave privada Ed25519 en Base64 (32 bytes) para firmar automáticamente bundles registrados vía UI/API.
HOSTGRID_BUNDLE_SIGNING_PRIVKEY_B64=

# Opcional: provisión inicial de cuenta admin en primer arranque (dejar vacío tras inicializar).
HOSTGRID_BOOTSTRAP_ADMIN_USERNAME=
HOSTGRID_BOOTSTRAP_ADMIN_EMAIL=
HOSTGRID_BOOTSTRAP_ADMIN_PASSWORD=

# --- Frontend Web ---
HOSTGRID_WEB_PORT=8080
# Por defecto proxy HTTP hacia `server:8000`. Al activar TLS/mTLS nativo en `server`, ajustar a:
#   HOSTGRID_WEB_UPSTREAM_URL=https://server:8443
#   HOSTGRID_WEB_UPSTREAM_CA=/etc/hostgrid/certs/ca.pem
#   (y opcionalmente HOSTGRID_WEB_UPSTREAM_CLIENT_CERT/KEY para mTLS, descomentar volumen ./certs/web)
HOSTGRID_WEB_UPSTREAM_URL=http://server:8000
HOSTGRID_WEB_UPSTREAM_CA=
HOSTGRID_WEB_UPSTREAM_CLIENT_CERT=
HOSTGRID_WEB_UPSTREAM_CLIENT_KEY=

# --- Nodo Relay DMZ (opcional, perfil --profile relay) ---
# Para TLS/mTLS descomentar `./certs/relay:/etc/hostgrid/certs:ro` en deploy/docker-compose.yml.
# HOSTGRID_RELAY_UPSTREAM debe usar https:// (ya sea https://server:8443 con TLS nativo en server
# o el reverse proxy HTTPS frente al Control Plane).
HOSTGRID_RELAY_PORT=8443
HOSTGRID_RELAY_UPSTREAM=https://server:8443
HOSTGRID_RELAY_TLS_CERT=
HOSTGRID_RELAY_TLS_KEY=
HOSTGRID_RELAY_CLIENT_CA=
HOSTGRID_RELAY_UPSTREAM_CA=
HOSTGRID_RELAY_UPSTREAM_CLIENT_CERT=
HOSTGRID_RELAY_UPSTREAM_CLIENT_KEY=
# Variables del subcomando `hostgrid-relay healthcheck` cuando el Relay usa TLS 1.3 / mTLS entrante:
HOSTGRID_RELAY_HEALTH_URL=
HOSTGRID_RELAY_HEALTH_CA=
HOSTGRID_RELAY_HEALTH_CLIENT_CERT=
HOSTGRID_RELAY_HEALTH_CLIENT_KEY=
